# Flask Environment Configuration
FLASK_ENV=production
FLASK_DEBUG=false

# Generate a strong secret key (e.g. using `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=change_this_to_a_secure_random_32_byte_hex_string

# Database URI (Defaults to local SQLite todo.db)
DATABASE_URL=sqlite:///todo.db

# Cookie & Security Configuration
SESSION_COOKIE_SECURE=false # Set to true when serving over HTTPS
PORT=5000

# Gmail / Custom SMTP Configuration for Email Reminders & Password Resets
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
